<?xml version="1.0" ?>
<!--
  SAR World: sparse_trees
  Flat terrain with 15-25 trees/bushes, drone (X3 UAV), 6 humans — partial occlusion S2 scenario.
-->
<sdf version="1.9">
  <world name="sparse_trees">

    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"           name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"               name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-magnetometer-system"      name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-air-pressure-system"      name="gz::sim::systems::AirPressure"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.3 0.48 0.18 1</ambient>
            <diffuse>0.3 0.48 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================== TREES (15 trees — sparse) ======================== -->
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>tree_1</name><pose>10 5 0 0 0 0</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>tree_2</name><pose>-12 8 0 0 0 0.6</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>tree_3</name><pose>20 -10 0 0 0 1.0</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>tree_4</name><pose>-18 -15 0 0 0 0.3</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>tree_5</name><pose>5 -22 0 0 0 1.5</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>tree_6</name><pose>-25 3 0 0 0 0</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>tree_7</name><pose>15 20 0 0 0 0.9</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>tree_8</name><pose>-8 25 0 0 0 0.2</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>tree_9</name><pose>26 12 0 0 0 1.2</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <name>tree_10</name><pose>3 -15 0 0 0 0.7</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine tree</uri>
      <name>tree_11</name><pose>-22 -5 0 0 0 0</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine tree</uri>
      <name>tree_12</name><pose>12 -20 0 0 0 1.1</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine tree</uri>
      <name>tree_13</name><pose>-6 -8 0 0 0 0.4</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine tree</uri>
      <name>tree_14</name><pose>22 0 0 0 0 0.8</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine tree</uri>
      <name>tree_15</name><pose>-15 20 0 0 0 0.1</pose></include>

    <!-- ======================== ROCKS ======================== -->
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Cinder Block</uri>
      <name>rock_1</name><pose>7 -5 0 0 0 0</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Cinder Block</uri>
      <name>rock_2</name><pose>-10 15 0 0 0 0.7</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Cinder Block</uri>
      <name>rock_3</name><pose>18 -18 0 0 0 1.3</pose></include>

    <!-- ======================== HUMANS (6 total, some partially under trees) ======================== -->
    <!-- Human 1: by tree_1 (partial occlusion) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>human_1</name><pose>10.8 5 0 0 0 0.5</pose>
    </include>

    <!-- Human 2: open area -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>human_2</name><pose>-5 -3 0 0 0 1.2</pose>
    </include>

    <!-- Human 3: near tree_4 -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking person</uri>
      <name>human_3</name><pose>-17 -14 0 0 0 0</pose>
    </include>

    <!-- Human 4: near tree_9 edge -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>human_4</name><pose>25.5 12.5 0 0 0 2.0</pose>
    </include>

    <!-- Human 5: open NW quadrant -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>human_5</name><pose>-24 10 0 0 0 -0.3</pose>
    </include>

    <!-- Human 6: walking, open south -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking person</uri>
      <name>human_6</name><pose>2 -25 0 0 0 1.0</pose>
    </include>

    <!-- ======================== X3 DRONE (identical to open_field) ======================== -->
    <model name="X3">
      <pose>0 0 0.2 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.029125</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.029125</iyy><iyz>0</iyz>
            <izz>0.055225</izz>
          </inertia>
        </inertial>
        <visual name="body_visual">
          <geometry><box><size>0.47 0.47 0.11</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="body_collision">
          <geometry><box><size>0.47 0.47 0.11</size></box></geometry>
        </collision>
        <sensor name="camera" type="camera">
          <pose>0.1 0 -0.05 0 1.047 0</pose>
          <topic>/camera</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>300</far></clip>
            <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
          </camera>
        </sensor>
        <sensor name="camera_info" type="camera">
          <pose>0.1 0 -0.05 0 1.047 0</pose>
          <topic>/camera_info</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>300</far></clip>
          </camera>
        </sensor>
        <sensor name="imu_sensor" type="imu">
          <topic>/imu</topic><update_rate>250</update_rate>
        </sensor>
        <sensor name="air_pressure" type="air_pressure">
          <topic>/air_pressure</topic><update_rate>50</update_rate>
        </sensor>
      </link>

      <plugin filename="gz-sim-multicopter-control-system"
              name="gz::sim::systems::MulticopterVelocityControl">
        <robotNamespace>X3</robotNamespace>
        <commandSubTopic>gazebo/command/twist</commandSubTopic>
        <enableSubTopic>enable</enableSubTopic>
        <comLinkName>base_link</comLinkName>
        <velocityGain>2.7 2.7 2.7</velocityGain>
        <attitudeGain>2 3 0.15</attitudeGain>
        <angularRateGain>0.4 0.52 0.18</angularRateGain>
        <maximumLinearAcceleration>2 2 2</maximumLinearAcceleration>
        <maximumLinearVelocity>3 3 3</maximumLinearVelocity>
        <maximumAngularVelocity>3 3 3</maximumAngularVelocity>
        <linearVelocityNoiseMean>0 0 0</linearVelocityNoiseMean>
        <linearVelocityNoiseStdDev>0.1105 0.1261 0.1204</linearVelocityNoiseStdDev>
        <angularVelocityNoiseMean>0 0 0</angularVelocityNoiseMean>
        <angularVelocityNoiseStdDev>0.008 0.008 0.004</angularVelocityNoiseStdDev>
        <rotorConfiguration>
          <rotor>
            <jointName>rotor_0_joint</jointName>
            <forceConstant>8.54858e-06</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>1</direction>
          </rotor>
        </rotorConfiguration>
      </plugin>

      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>X3/base_link</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/model/X3/odometry</odom_topic>
      </plugin>
    </model>

  </world>
</sdf>
